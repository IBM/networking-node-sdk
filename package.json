{
  "name": "ibm-networking-services",
  "version": "0.40.0",
  "description": "Node.js client library for IBM Cloud Networking Services",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IBM/networking-node-sdk.git"
  },
  "keywords": [
    "ibm"
  ],
  "author": "IBM Corp.",
  "scripts": {
    "eslint:fix": "eslint . --fix",
    "eslint:check": "eslint . --cache",
    "tslint:fix": "tslint --fix -p . -c tslint.json",
    "tslint:check": "tslint -p . -c ./tslint.json",
    "lint": "npm run eslint:check && npm run tslint:check",
    "lint-fix": "npm run eslint:fix && npm run tslint:fix",
    "build": "tsc && cp package.json dist/",
    "prepublishOnly": "npm run build",
    "postversion": "tsc-publish --no-checks --dry-run",
    "jest": "jest",
    "test": "npm run build && npm run lint && jest test/",
    "test-unit": "npm run build && jest test/unit/",
    "test-integration": "npm run build && jest test/integration",
    "test-integration-transit": "npm run build && jest test/integration/transit-gateway.v1.test.js",
    "test-ci": "jest --runInBand --testNamePattern='^((?!@slow).)*$' test/",
    "test-unit-ci": "jest --runInBand test/unit/",
    "test-integration-ci": "jest --runInBand --no-colors --testNamePattern='^((?!@slow).)*$' --json test/integration > test-output.log",
    "check-packages": "installed-check -e -d -v"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ibm-cloud/sdk-test-utilities": "^1.0.0",
    "@types/extend": "^3.0.4",
    "@types/node": "^24.0.0",
    "extend": "^3.0.2",
    "ibm-cloud-sdk-core": "^5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@ibm-cloud/sdk-test-utilities": "^1.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "ansi-regex": "^6.0.1",
    "axios": "^1.7.4",
    "dotenv": "^18.0.0",
    "eslint": "^10.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-n": "^18.0.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.0.0",
    "highlight.js": "^11.12.0",
    "installed-check": "^11.0.0",
    "jest": "^30.0.0",
    "nock": "^14.0.17",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "set-value": "^4.1.0",
    "tsc-publish": "^0.5.2",
    "tslint": "^6.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.2",
    "yargs-parser": "^22.0.0"
  },
  "overrides": {
    "braces": "^3.0.3",
    "expect": "^30.5.0",
    "postcss-selector-parser": "^7.1.6",
    "ip-address": "^10.7.1",
    "brace-expansion": "^5.0.12",
    "http-cache-semantics": "^4.3.0",
    "typedoc": {
      "markdown-it": "^15.0.2"
    }
  },
  "jest": {
    "collectCoverage": true,
    "coverageDirectory": "./coverage/",
    "coveragePathIgnorePatterns": [
      "<rootDir>/test/"
    ],
    "testEnvironment": "node"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
