{
  "compilerOptions": {
    /* Basic Options */
    "target": "es2020",                       /* Node >=20 has full ES2020 support; no need to down-compile to ES5. */
    "module": "commonjs",                     /* CommonJS output for Node.js. */
    "lib": ["es2020"],                        /* ES2020 stdlib only — no browser (dom/scripthost) libs needed for a Node SDK. */

    /* Build source files into a folder called `dist` to maintain clean directories, free of ts-generated files */
    "outDir": "./dist",

    /* Specify library files to be included in the compilation:  */
    "declaration": true,                   /* Generates corresponding '.d.ts' file. */
    "sourceMap": true,                     /* Generates corresponding '.map' file. */

    /* Strict Type-Checking Options */
    "alwaysStrict": true,                   /* Parse in strict mode and emit "use strict" for each source file. */

    /* Module Resolution Options */
    "types": ["node", "extend"]              /* Type declaration files to be included in compilation. */
  }
}
